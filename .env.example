# Copie para .env.local e preencha com seus valores reais.

# Postgres (Neon em produção, local espelhado em dev)
DATABASE_URL=postgresql://usuario:senha@host:5432/banco?sslmode=require

# Token que protege a rota /api/sync-fipe (sincronização com a Tabela FIPE)
SYNC_TOKEN=defina-um-token-aleatorio-aqui
